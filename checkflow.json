{
  "$schema": "./.checkflow/checkflow.schema.json",
  "project": {
    "name": "Axiom",
    "language": "cpp"
  },
  "flows": {
    "fast": [
      {
        "id": "architecture",
        "tool": "architecture"
      },
      {
        "id": "configure",
        "tool": "cmake",
        "timeout": 300,
        "args": {
          "action": "configure",
          "preset": "quality-fast"
        }
      },
      {
        "id": "build",
        "tool": "cmake",
        "depends_on": ["configure"],
        "timeout": 600,
        "args": {
          "action": "build",
          "preset": "quality-fast"
        }
      },
      {
        "id": "clean_coverage",
        "tool": "coverage",
        "depends_on": ["build"],
        "args": {
          "action": "clean",
          "build_directory": "build-quality/fast"
        }
      },
      {
        "id": "unit_tests",
        "tool": "ctest",
        "depends_on": ["clean_coverage"],
        "timeout": 600,
        "args": {
          "preset": "quality-fast"
        }
      },
      {
        "id": "coverage",
        "tool": "coverage",
        "depends_on": ["unit_tests"],
        "timeout": 300,
        "args": {
          "build_directory": "build-quality/fast",
          "preset": "quality-fast",
          "thresholds": {
            "lines": 90,
            "regions": 90,
            "branches": 90
          },
          "required_cache_option": "AXIOM_COVERAGE"
        }
      },
      {
        "id": "coverage_integrity",
        "tool": "cmake",
        "depends_on": ["coverage"],
        "args": {
          "action": "build",
          "preset": "quality-fast",
          "options": ["--target", "axiom_verify_coverage"]
        }
      }
    ],
    "full": [
      {
        "id": "architecture",
        "tool": "architecture"
      },
      {
        "id": "format",
        "tool": "format"
      },
      {
        "id": "configure",
        "tool": "cmake",
        "timeout": 300,
        "args": {
          "action": "configure",
          "preset": "quality-full"
        }
      },
      {
        "id": "build",
        "tool": "cmake",
        "depends_on": ["configure"],
        "timeout": 600,
        "args": {
          "action": "build",
          "preset": "quality-full"
        }
      },
      {
        "id": "complexity",
        "tool": "lizard",
        "depends_on": ["build"],
        "args": {
          "language": "cpp",
          "complexity": 10,
          "length": 80,
          "arguments": 5,
          "paths": ["include", "src", "apps", "tests"]
        }
      },
      {
        "id": "cppcheck",
        "tool": "cppcheck",
        "depends_on": ["build"],
        "timeout": 600,
        "args": {
          "compilation_database": "build-quality/full",
          "include": ["include/**", "src/**", "apps/**", "tests/**"],
          "exclude": ["build/**"],
          "options": [
            "--enable=warning,style,performance,portability",
            "--library=googletest"
          ]
        }
      },
      {
        "id": "clang_tidy",
        "tool": "clang_tidy",
        "depends_on": ["build"],
        "timeout": 600,
        "args": {
          "compilation_database": "build-quality/full",
          "include": ["include/**", "src/**", "apps/**", "tests/**"],
          "warnings_as_errors": "*",
          "headers": true
        }
      },
      {
        "id": "clean_coverage",
        "tool": "coverage",
        "depends_on": ["build"],
        "args": {
          "action": "clean",
          "build_directory": "build-quality/full"
        }
      },
      {
        "id": "unit_tests",
        "tool": "ctest",
        "depends_on": ["clean_coverage"],
        "timeout": 900,
        "args": {
          "preset": "quality-full"
        }
      },
      {
        "id": "coverage",
        "tool": "coverage",
        "depends_on": ["unit_tests"],
        "timeout": 300,
        "args": {
          "build_directory": "build-quality/full",
          "preset": "quality-full",
          "thresholds": {
            "lines": 90,
            "regions": 90,
            "branches": 90
          },
          "required_cache_option": "AXIOM_COVERAGE"
        }
      },
      {
        "id": "coverage_integrity",
        "tool": "cmake",
        "depends_on": ["coverage"],
        "args": {
          "action": "build",
          "preset": "quality-full",
          "options": ["--target", "axiom_verify_coverage"]
        }
      },
      {
        "id": "embedding_contract",
        "command": "cmake -S tests/cmake -B build-quality/embedding -G Ninja",
        "depends_on": ["coverage_integrity"],
        "timeout": 300
      },
      {
        "id": "static_configure",
        "tool": "cmake",
        "depends_on": ["embedding_contract"],
        "timeout": 600,
        "args": {
          "action": "configure",
          "preset": "quality-static"
        }
      },
      {
        "id": "static_build",
        "tool": "cmake",
        "depends_on": ["static_configure"],
        "timeout": 600,
        "args": {
          "action": "build",
          "preset": "quality-static"
        }
      },
      {
        "id": "static_tests",
        "tool": "ctest",
        "depends_on": ["static_build"],
        "timeout": 900,
        "args": {
          "preset": "quality-static"
        }
      },
      {
        "id": "shared_configure",
        "tool": "cmake",
        "depends_on": ["static_tests"],
        "timeout": 600,
        "args": {
          "action": "configure",
          "preset": "quality-shared"
        }
      },
      {
        "id": "shared_build",
        "tool": "cmake",
        "depends_on": ["shared_configure"],
        "timeout": 600,
        "args": {
          "action": "build",
          "preset": "quality-shared"
        }
      },
      {
        "id": "shared_tests",
        "tool": "ctest",
        "depends_on": ["shared_build"],
        "timeout": 900,
        "args": {
          "preset": "quality-shared"
        }
      }
    ],
    "hardening": [
      {
        "id": "clear_build",
        "command": "cmake -E rm -rf build-quality/hardening build-quality/mutation"
      },
      {
        "id": "configure",
        "tool": "cmake",
        "depends_on": ["clear_build"],
        "timeout": 300,
        "args": {
          "action": "configure",
          "preset": "quality-hardening"
        }
      },
      {
        "id": "build",
        "tool": "cmake",
        "depends_on": ["configure"],
        "timeout": 600,
        "args": {
          "action": "build",
          "preset": "quality-hardening"
        }
      },
      {
        "id": "unit_tests",
        "tool": "ctest",
        "depends_on": ["build"],
        "timeout": 900,
        "args": {
          "preset": "quality-hardening"
        }
      },
      {
        "id": "mutation",
        "tool": "mull",
        "depends_on": ["unit_tests"],
        "timeout": 1800,
        "args": {
          "preset": "quality-mutation",
          "build_directory": "build-quality/mutation",
          "frontend_cache_option": "AXIOM_MULL_IR_FRONTEND",
          "threshold": 70,
          "options": ["--timeout", "2000"]
        }
      },
      {
        "id": "mutation_integrity",
        "tool": "cmake",
        "depends_on": ["mutation"],
        "args": {
          "action": "build",
          "preset": "quality-mutation",
          "options": ["--target", "axiom_verify_mutation"]
        }
      }
    ]
  }
}
