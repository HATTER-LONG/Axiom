# https://clang.llvm.org/extra/clang-tidy/checks/list.html

Checks: "-*,
    clang-diagnostic-*,
    misc-*,
    bugprone-*,
    performance-*,
    modernize-*,
    readability-*,
    -misc-non-private-member-variables-in-classes,
    -misc-use-anonymous-namespace,
    -modernize-use-trailing-return-type,
    -readability-magic-numbers,
    -readability-identifier-length,
    -bugprone-exception-escape"

HeaderFileExtensions: ['', 'h', 'hh', 'hpp', 'hxx']
ImplementationFileExtensions: ['c', 'cc', 'cpp', 'cxx']
HeaderFilterRegex: '.*'

CheckOptions:

  # =========================
  # Types
  # =========================

  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase

  # =========================
  # Namespace
  # =========================

  readability-identifier-naming.NamespaceCase: lower_case

  # =========================
  # Functions / Methods
  # =========================

  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.MethodCase: camelBack

  # =========================
  # Variables
  # =========================

  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.LocalVariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case

  # =========================
  # Class members
  #
  # class:
  #   int count_;
  #
  # struct/public data:
  #   int count;
  # =========================

  # Private/protected implementation state.
  readability-identifier-naming.PrivateMemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: _

  readability-identifier-naming.ProtectedMemberCase: lower_case
  readability-identifier-naming.ProtectedMemberSuffix: _

  # Public data members.
  readability-identifier-naming.PublicMemberCase: lower_case

  # =========================
  # Constants
  # =========================

  readability-identifier-naming.StaticConstantCase: UPPER_CASE
  readability-identifier-naming.LocalConstantCase: lower_case

  # =========================
  # Macro-generated identifiers
  # =========================

  # AXIOM_LOG evaluates logger/level once.
  # Trailing '_' is macro call-site hygiene rather than the naming convention
  # used by handwritten local variables.
  readability-identifier-naming.LocalVariableIgnoredRegexp: '^axiom_log_logger_$'
  readability-identifier-naming.LocalConstantIgnoredRegexp: '^axiom_log_level_$'

  # Allow framework/project macros when cppcoreguidelines-macro-usage is enabled.
  # NOTE: cppcoreguidelines-* is not currently enabled by Checks above, so this
  # option is currently dormant but safe to keep for future use.
  cppcoreguidelines-macro-usage.AllowedRegexp: '^(AXIOM_|QT_|Q_|GTEST_|EXPECT_|ASSERT_).*'

  # =========================
  # Function complexity / size
  # =========================

  # Lizard owns:
  #   - function NLOC
  #   - parameter count
  #   - cyclomatic complexity
  #
  # clang-tidy complements those metrics with:
  #   - nesting depth
  #   - cognitive complexity

  # Keep handwritten control flow shallow.
  readability-function-size.NestingThreshold: '4'

  # Ignore control flow introduced by macro expansion, such as AXIOM_LOG,
  # GoogleTest assertions, and similar framework macros.
  readability-function-size.IgnoreMacros: 'true'

  # Human-oriented complexity:
  # penalizes branches, loops, and deeply nested control flow.
  readability-function-cognitive-complexity.Threshold: '15'

  # Ignore complexity introduced by macro expansion.
  readability-function-cognitive-complexity.IgnoreMacros: 'true'
