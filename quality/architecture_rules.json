{
  "schema": "axiom-architecture-rules/v1",
  "forbidden_include_prefixes": [
    {
      "id": "core-must-not-depend-on-app-or-test",
      "from": ["src/core/"],
      "forbidden": ["apps/", "tests/"]
    },
    {
      "id": "runtime-must-not-depend-on-app-or-test",
      "from": ["src/runtime/"],
      "forbidden": ["apps/", "tests/"]
    },
    {
      "id": "runtime-must-not-depend-on-other-modules",
      "from": ["src/runtime/"],
      "forbidden": ["src/core/"]
    }
  ]
}
