{
  "schema": "axiom-architecture-rules/v1",
  "forbidden_include_prefixes": [
    {
      "id": "core-must-not-depend-on-app-or-test",
      "from": ["src/core/"],
      "forbidden": ["apps/", "tests/"]
    },
    {
      "id": "core-base-must-not-depend-on-action",
      "from": ["src/core/include/axiom/core/base/", "src/core/src/base/"],
      "forbidden": ["axiom/core/action/"]
    }
  ]
}
