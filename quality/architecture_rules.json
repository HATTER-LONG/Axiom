{
  "schema": "axiom-architecture-rules/v1",
  "forbidden_include_prefixes": [
    {
      "id": "lower-layers-must-not-depend-on-command",
      "from": [
        "src/foundation/",
        "include/axiom/foundation/",
        "src/action/",
        "include/axiom/action/",
        "src/resource/",
        "include/axiom/resource/",
        "src/task/",
        "include/axiom/task/",
        "src/async/",
        "include/axiom/async/",
        "src/events/",
        "include/axiom/events/",
        "src/logging/",
        "include/axiom/logging/",
        "src/introspection/",
        "include/axiom/introspection/"
      ],
      "forbidden": ["axiom/command/"]
    },
    {
      "id": "lower-layers-must-not-depend-on-introspection",
      "from": [
        "src/foundation/",
        "include/axiom/foundation/",
        "src/action/",
        "include/axiom/action/",
        "src/resource/",
        "include/axiom/resource/",
        "src/task/",
        "include/axiom/task/",
        "src/async/",
        "include/axiom/async/",
        "src/events/",
        "include/axiom/events/",
        "src/logging/",
        "include/axiom/logging/"
      ],
      "forbidden": ["axiom/introspection/"]
    },
    {
      "id": "library-must-not-depend-on-app-or-test",
      "from": ["src/", "include/axiom/"],
      "forbidden": ["apps/", "tests/"]
    },
    {
      "id": "task-must-not-depend-on-higher-layers",
      "from": ["src/task/", "include/axiom/task/"],
      "forbidden": ["axiom/action/", "axiom/resource/", "apps/", "tests/"]
    },
    {
      "id": "foundation-must-remain-independent",
      "from": ["src/foundation/", "include/axiom/foundation/"],
      "forbidden": ["axiom/action/", "axiom/logging/", "axiom/resource/", "axiom/events/", "axiom/async/", "axiom/task/"]
    },
    {
      "id": "logging-must-not-depend-on-higher-layers",
      "from": ["src/logging/", "include/axiom/logging/"],
      "forbidden": ["axiom/action/", "axiom/resource/", "axiom/events/", "axiom/async/", "axiom/task/", "apps/", "tests/"]
    },
    {
      "id": "resource-must-remain-independent",
      "from": ["src/resource/", "include/axiom/resource/"],
      "forbidden": ["axiom/action/", "axiom/logging/", "axiom/events/", "axiom/async/", "axiom/task/", "apps/", "tests/"]
    },
    {
      "id": "events-must-not-depend-on-services",
      "from": ["src/events/", "include/axiom/events/"],
      "forbidden": ["axiom/action/", "axiom/logging/", "axiom/resource/", "axiom/async/", "axiom/task/"]
    },
    {
      "id": "async-must-not-depend-on-services",
      "from": ["src/async/", "include/axiom/async/"],
      "forbidden": ["axiom/action/", "axiom/logging/", "axiom/resource/", "axiom/events/", "axiom/task/"]
    },
    {
      "id": "command-must-not-depend-on-action-detail",
      "from": ["src/command/", "include/axiom/command/"],
      "forbidden": ["axiom/action/detail/"]
    },
    {
      "id": "core-must-not-depend-on-python",
      "from": [
        "src/foundation/",
        "include/axiom/foundation/",
        "src/action/",
        "include/axiom/action/",
        "src/resource/",
        "include/axiom/resource/",
        "src/task/",
        "include/axiom/task/",
        "src/async/",
        "include/axiom/async/",
        "src/events/",
        "include/axiom/events/",
        "src/logging/",
        "include/axiom/logging/",
        "src/introspection/",
        "include/axiom/introspection/",
        "src/command/",
        "include/axiom/command/"
      ],
      "forbidden": ["axiom/python/"]
    },
    {
      "id": "python-adapter-must-not-depend-on-module-detail",
      "from": ["src/python/", "include/axiom/python/"],
      "forbidden": ["axiom/action/detail/", "axiom/task/detail/"]
    }
  ]
}
