{
  "report_schema": "check-test/v1",
  "architecture_rules": "policy/architecture.json",
  "architecture_rules_schema": "check-test-architecture/v1",
  "coverage_cache_option": "FIXTURE_COVERAGE",
  "mutation_frontend_option": "FIXTURE_MULL_FRONTEND",
  "source_roots": ["library", "spec"],
  "build_directories": {
    "fixture-fast": "out/fast",
    "fixture-full": "out/full",
    "fixture-hardening": "out/hardening",
    "fixture-mutation": "out/mutation"
  },
  "coverage_threshold": 90.0,
  "coverage_ignore_regex": "[/\\\\]spec[/\\\\]",
  "mutation_score_threshold": 90.0,
  "presets": {
    "fast": "fixture-fast",
    "full": "fixture-full",
    "hardening": "fixture-hardening",
    "mutation": "fixture-mutation"
  }
}
