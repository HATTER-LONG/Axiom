{
  "version": 6,
  "configurePresets": [
    {"name":"fixture-fast","generator":"Ninja","binaryDir":"${sourceDir}/out/fast","cacheVariables":{"CMAKE_CXX_COMPILER":"clang++","CMAKE_EXPORT_COMPILE_COMMANDS":"ON","BUILD_TESTING":"ON","FIXTURE_COVERAGE":"ON"}},
    {"name":"fixture-full","inherits":"fixture-fast","binaryDir":"${sourceDir}/out/full"},
    {"name":"fixture-hardening","inherits":"fixture-fast","binaryDir":"${sourceDir}/out/hardening","cacheVariables":{"FIXTURE_COVERAGE":"OFF","FIXTURE_SANITIZERS":"address,undefined"}},
    {"name":"fixture-mutation","inherits":"fixture-fast","binaryDir":"${sourceDir}/out/mutation"}
  ],
  "buildPresets": [
    {"name":"fixture-fast","configurePreset":"fixture-fast"},
    {"name":"fixture-full","configurePreset":"fixture-full"},
    {"name":"fixture-hardening","configurePreset":"fixture-hardening"},
    {"name":"fixture-mutation","configurePreset":"fixture-mutation"}
  ],
  "testPresets": [
    {"name":"fixture-fast","configurePreset":"fixture-fast","output":{"outputOnFailure":true}},
    {"name":"fixture-full","configurePreset":"fixture-full","output":{"outputOnFailure":true}},
    {"name":"fixture-hardening","configurePreset":"fixture-hardening","output":{"outputOnFailure":true}}
  ]
}
