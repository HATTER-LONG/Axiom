CompileFlags:
  CompilationDatabase: build

Diagnostics:
  ClangTidy:
    FastCheckFilter: Strict

  # UnusedIncludes: Strict
  # MissingIncludes: None

Completion:
  AllScopes: Yes
  ArgumentLists: FullPlaceholders
  HeaderInsertion: IWYU
  CodePatterns: All

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
  Designators: true
  BlockEnd: false
  DefaultArguments: false
  TypeNameLimit: 32

Hover:
  ShowAKA: true
  MacroContentsLimit: 2048

Documentation:
  CommentFormat: Markdown

---
# Don't background-index CPM downloaded third-party translation units.
If:
  PathMatch: .*/\.cache/CPM/.*

Index:
  Background: Skip

Diagnostics:
  Suppress: "*"
