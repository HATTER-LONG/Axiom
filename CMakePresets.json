{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "AXIOM_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Developer build",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "AXIOM_BUILD_TESTS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug build",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "quality-fast",
      "displayName": "Quality gate: fast",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-quality/fast",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "AXIOM_BUILD_TESTS": "ON",
        "BUILD_TESTING": "ON",
        "AXIOM_STATIC_ANALYZERS": "",
        "AXIOM_COVERAGE": "ON"
      }
    },
    {
      "name": "quality-full",
      "displayName": "Quality gate: full",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-quality/full",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "AXIOM_BUILD_TESTS": "ON",
        "BUILD_TESTING": "ON",
        "AXIOM_STATIC_ANALYZERS": "",
        "AXIOM_COVERAGE": "ON"
      }
    },
    {
      "name": "quality-hardening",
      "displayName": "Quality gate: hardening",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-quality/hardening",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "AXIOM_BUILD_TESTS": "ON",
        "BUILD_TESTING": "ON",
        "AXIOM_STATIC_ANALYZERS": "",
        "AXIOM_MUTATION_TESTING": "OFF",
        "AXIOM_SANITIZERS": "Address;Undefined"
      }
    },
    {
      "name": "quality-mutation",
      "displayName": "Quality gate: mutation testing",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-quality/mutation",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "AXIOM_BUILD_DEMO": "OFF",
        "AXIOM_BUILD_TESTS": "ON",
        "BUILD_TESTING": "ON",
        "AXIOM_STATIC_ANALYZERS": "",
        "AXIOM_MUTATION_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev", "jobs": 16 },
    { "name": "debug", "configurePreset": "debug", "jobs": 16 },
    { "name": "quality-fast", "configurePreset": "quality-fast", "jobs": 16 },
    { "name": "quality-full", "configurePreset": "quality-full", "jobs": 16 },
    {
      "name": "quality-hardening",
      "configurePreset": "quality-hardening",
      "jobs": 16
    },
    {
      "name": "quality-mutation",
      "configurePreset": "quality-mutation",
      "jobs": 16
    }
  ],
  "testPresets": [
    {
      "name": "quality-fast",
      "configurePreset": "quality-fast",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "quality-full",
      "configurePreset": "quality-full",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "quality-hardening",
      "configurePreset": "quality-hardening",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "quality-mutation",
      "configurePreset": "quality-mutation",
      "output": { "outputOnFailure": true }
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "displayName": "Configure and build developer configuration",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" }
      ]
    },
    {
      "name": "debug",
      "displayName": "Configure and build debug configuration",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" }
      ]
    }
  ]
}
